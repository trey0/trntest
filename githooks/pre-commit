#!/bin/sh
# Lints exactly the staged .py files about to be committed. Runs via `trntest-lint` directly if
# it's on PATH (e.g. a host venv from `pip install -e '.[dev]'`); otherwise falls back to running
# it inside Docker, so this hook works on any host with just Docker installed -- no host-side
# Python setup required, better isolation from host environment differences across developers.
#
# Known limitation: this lints the *working-tree* content of each staged file, not the exact
# staged blob -- if a file is only partially staged (some hunks staged, some not), this may check
# content slightly different from what will actually be committed. Fully solving that requires
# checking out the staged blob to a temp location before linting, which is more machinery than
# this repo needs; this is the same tradeoff the standalone `pre-commit` framework makes unless
# its "stash unstaged changes" mode is explicitly enabled, and is why this repo deliberately
# avoids that framework (see README).

set -e

STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

if [ -z "$STAGED_PY_FILES" ]; then
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)

if command -v trntest-lint >/dev/null 2>&1; then
    echo "$STAGED_PY_FILES" | xargs trntest-lint
elif command -v docker >/dev/null 2>&1; then
    echo "pre-commit: 'trntest-lint' not on PATH, running it in Docker instead (may take a" >&2
    echo "moment to build the image on first use)..." >&2
    echo "$STAGED_PY_FILES" | xargs docker compose -f "$REPO_ROOT/docker/docker-compose.yml" run --rm demo trntest-lint
else
    echo "pre-commit: neither 'trntest-lint' nor 'docker' found on PATH." >&2
    echo "Install Docker, or run: pip install -e '.[dev]'  (see README's Development setup section)" >&2
    exit 1
fi
