__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.venv/
print.prt

# Per-checkout Docker Compose overrides, generated by scripts/setup_worktree_docker_env.sh --
# see docker-compose.yml's top comment and docs/environment.md's "Multi-agent worktrees" section.
docker/.env

# Claude Code worktree checkouts (.claude/worktrees/<name>/, each a nested git worktree) -- must
# never be tracked from the main checkout.
.claude/

# Written by scripts/mark_worktree_done.sh at a worktree's own root -- see
# scripts/cleanup_worktrees.sh and docs/collaboration.md's "Recommend branch cleanup at session
# closeout" section.
/.session-done

# cache/output/scratch live outside this repo entirely (see docs/environment.md), but
# docker-compose.yml bind-mounts them at these paths inside the container, nested under this
# repo's own working directory from git's point of view -- without these entries, `git ls-files
# --others` (and therefore `trntest-lint --all`) walks into them and reports their contents as
# untracked files.
/cache/
/output/
/scratch/
